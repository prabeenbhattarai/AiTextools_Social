# ---------------------------------------------------------------------------
# Copy to `.env.local` for local dev. On Vercel set these in
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Firebase Admin (server-side; used for Firestore) ---
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Auth secrets ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Secret required by the one-time /setup page to create the first superadmin.
SETUP_SECRET=
